# PAD is intentionally unconfigured. PAD_MODEL_PATH is not activated by this app.
# Development server should remain local.
HOST=127.0.0.1
PORT=8000

# Optional local inference. Features fall back safely when packages/weights are absent.
OBJECT_DEVICE=auto
ENABLE_SCENE_CAPTIONER=0
SCENE_MODEL=Salesforce/blip-image-captioning-base
SCENE_DEVICE=auto
